generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SUSPENDED
  DISABLED
  LOCKED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmployeeStatus {
  ACTIVE
  DISABLED
}

enum LoginMethod {
  EMAIL
  EMPLOYEE_NO
}

enum Platform {
  META
  TIKTOK
}

enum PlatformAssetType {
  BUSINESS_CENTER
  FACEBOOK_PAGE
  PIXEL
  TIKTOK_ADVERTISER
  TIKTOK_APP
  CATALOG
  PRODUCT_FEED
}

enum DataScopeType {
  ALL_TEAMS
  TEAM
  PLATFORM
  AD_ACCOUNT
  CAMPAIGN_TAG
  OWNER_ONLY
}

enum TeamMemberStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum PublishStatus {
  DRAFT
  CREATING
  PUBLISHED
  PARTIALLY_FAILED
  FAILED
  PAUSED
  ACTIVE
  ARCHIVED
}

enum PublishTaskStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum PlatformObjectType {
  CAMPAIGN
  AD_SET
  AD_GROUP
  CREATIVE
  AD
}

enum ReportSyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  passwordHash        String
  status              UserStatus          @default(PENDING_REVIEW)
  failedLoginAttempts Int                 @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  profile             UserProfile?
  reviewRequests      UserReviewRequest[] @relation("ReviewSubject")
  reviewsPerformed    UserReviewRequest[] @relation("ReviewActor")
  employeeAccounts    EmployeeAccount[]
  teamMemberships     TeamMember[]
  ownedTeams          Team[]              @relation("TeamOwner")
  sessions            Session[]
  loginLogs           LoginLog[]
  auditLogs           AuditLog[]          @relation("AuditActor")
  strategies          Strategy[]          @relation("StrategyCreator")
  targetings          Targeting[]         @relation("TargetingCreator")
  campaigns           Campaign[]          @relation("CampaignCreator")
  publishTasks        PublishTask[]       @relation("PublishTaskRequester")
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  companyName String?
  phone       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserReviewRequest {
  id             String       @id @default(cuid())
  userId         String
  status         ReviewStatus @default(PENDING)
  requestedNotes String?
  reviewNotes    String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation("ReviewSubject", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy     User?        @relation("ReviewActor", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model Team {
  id                  String               @id @default(cuid())
  name                String
  ownerId             String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  owner               User?                @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members             TeamMember[]
  roles               Role[]
  employeeAccounts    EmployeeAccount[]
  integrations        IntegrationAccount[]
  adAccounts          AdAccount[]
  platformAssets      PlatformAsset[]
  strategies          Strategy[]
  targetings          Targeting[]
  mediaAssets         MediaAsset[]
  copywritings        Copywriting[]
  adCreatives         AdCreative[]
  landingPages        LandingPage[]
  offers              Offer[]
  domains             Domain[]
  campaigns           Campaign[]
  publishTasks        PublishTask[]
  platformIdMappings  PlatformIdMapping[]
  accountDailyStats   AccountDailyStat[]
  campaignDailyStats  CampaignDailyStat[]
  reportSyncRuns      ReportSyncRun[]
  auditLogs           AuditLog[]
}

model TeamMember {
  id          String           @id @default(cuid())
  teamId      String
  userId      String
  roleId      String?
  status      TeamMemberStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role?            @relation(fields: [roleId], references: [id], onDelete: SetNull)
  permissions MemberPermission[]
  dataScopes  DataScope[]

  @@unique([teamId, userId])
}

model Role {
  id               String           @id @default(cuid())
  teamId           String?
  name             String
  description      String?
  isSystem         Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  team             Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members          TeamMember[]
  employeeAccounts EmployeeAccount[]
  permissions      RolePermission[]

  @@unique([teamId, name])
}

model Permission {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  description       String?
  createdAt         DateTime           @default(now())

  roles             RolePermission[]
  memberPermissions MemberPermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model MemberPermission {
  id           String     @id @default(cuid())
  memberId     String
  permissionId String
  allowed      Boolean    @default(true)

  member       TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([memberId, permissionId])
}

model EmployeeAccount {
  id           String         @id @default(cuid())
  employeeNo   String         @unique
  userId       String
  teamId       String
  roleId       String?
  status       EmployeeStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role         Role?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  dataScopes   DataScope[]
}

model DataScope {
  id                String           @id @default(cuid())
  teamMemberId      String?
  employeeAccountId String?
  scopeType         DataScopeType
  platform          Platform?
  adAccountId       String?
  campaignTag       String?
  ownerUserId       String?
  createdAt         DateTime         @default(now())

  teamMember        TeamMember?      @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  employeeAccount   EmployeeAccount? @relation(fields: [employeeAccountId], references: [id], onDelete: Cascade)
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginLog {
  id            String      @id @default(cuid())
  userId        String?
  employeeNo    String?
  method        LoginMethod
  success       Boolean
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([employeeNo, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  teamId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([actorId, createdAt])
}

model IntegrationAccount {
  id                    String      @id @default(cuid())
  teamId                String
  platform              Platform
  externalId            String
  name                  String
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  status                String      @default("active")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  team                  Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([platform, externalId])
}

model PlatformDeveloperConfig {
  id                 String   @id @default(cuid())
  platform           Platform @unique
  appId              String?
  appSecretEncrypted String?
  redirectUri        String?
  scopes             String[] @default([])
  apiVersion         String?
  apiBaseUrl         String?
  environment        String   @default("sandbox")
  isEnabled          Boolean  @default(false)
  updatedById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isEnabled])
}

model AdAccount {
  id         String   @id @default(cuid())
  teamId     String
  platform   Platform
  externalId String
  name       String
  currency   String?
  timezone   String?
  status     String?
  balance    Decimal? @db.Decimal(18, 4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  accountDailyStats  AccountDailyStat[]
  campaignDailyStats CampaignDailyStat[]
  reportSyncRuns     ReportSyncRun[]

  @@unique([platform, externalId])
}

model PlatformAsset {
  id           String            @id @default(cuid())
  teamId       String
  platform     Platform
  type         PlatformAssetType
  externalId   String
  name         String
  status       String?
  metadata     Json?
  lastSyncedAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  team         Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, platform, type, externalId])
  @@index([teamId, platform, type])
  @@index([lastSyncedAt])
}

model Strategy {
  id          String   @id @default(cuid())
  teamId      String
  createdById String?
  platform    Platform
  name        String
  config      Json
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("StrategyCreator", fields: [createdById], references: [id], onDelete: SetNull)
}

model Targeting {
  id          String   @id @default(cuid())
  teamId      String
  createdById String?
  platform    Platform
  name        String
  config      Json
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("TargetingCreator", fields: [createdById], references: [id], onDelete: SetNull)
}

model MediaAsset {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  fileType  String
  url       String
  thumbnail String?
  sizeBytes Int?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Copywriting {
  id          String   @id @default(cuid())
  teamId      String
  name        String
  primaryText String
  headline    String
  description String?
  tags        String[] @default([])
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model AdCreative {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  config    Json
  tags      String[] @default([])
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model LandingPage {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  url       String
  status    String   @default("draft")
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Offer {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  url       String
  price     Decimal? @db.Decimal(18, 4)
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Domain {
  id        String   @id @default(cuid())
  teamId    String
  domain    String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Campaign {
  id          String        @id @default(cuid())
  teamId      String
  createdById String?
  platform    Platform
  name        String
  status      PublishStatus @default(DRAFT)
  config      Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  publishTasks PublishTask[]
  platformIdMappings PlatformIdMapping[]
  dailyStats  CampaignDailyStat[]

  @@index([teamId, status])
  @@index([platform, status])
}

model PublishTask {
  id            String            @id @default(cuid())
  teamId        String
  campaignId    String
  platform      Platform
  status        PublishTaskStatus @default(PENDING)
  attempts      Int               @default(0)
  maxAttempts   Int               @default(3)
  payload       Json?
  result        Json?
  errorMessage  String?
  requestedById String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  team          Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  campaign      Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  requestedBy   User?             @relation("PublishTaskRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([teamId, status, createdAt])
  @@index([campaignId, createdAt])
}

model PlatformIdMapping {
  id           String             @id @default(cuid())
  teamId       String
  campaignId   String
  platform     Platform
  objectType   PlatformObjectType
  localKey     String
  externalId   String
  name         String?
  metadata     Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  team         Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  campaign     Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, objectType, localKey])
  @@index([teamId, platform, objectType])
  @@index([platform, objectType, externalId])
}

model AccountDailyStat {
  id          String   @id @default(cuid())
  teamId      String
  adAccountId String
  platform    Platform
  date        DateTime @db.Date
  currency    String?
  spend       Decimal  @default(0) @db.Decimal(18, 4)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  revenue     Decimal  @default(0) @db.Decimal(18, 4)
  raw         Json?
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@unique([teamId, adAccountId, date])
  @@index([teamId, platform, date])
  @@index([date])
}

model CampaignDailyStat {
  id          String   @id @default(cuid())
  teamId      String
  campaignId  String
  adAccountId String?
  platform    Platform
  date        DateTime @db.Date
  currency    String?
  spend       Decimal  @default(0) @db.Decimal(18, 4)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  revenue     Decimal  @default(0) @db.Decimal(18, 4)
  raw         Json?
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adAccount   AdAccount? @relation(fields: [adAccountId], references: [id], onDelete: SetNull)

  @@unique([teamId, campaignId, date])
  @@index([teamId, platform, date])
  @@index([campaignId, date])
  @@index([adAccountId, date])
}

model ReportSyncRun {
  id          String           @id @default(cuid())
  teamId      String
  platform    Platform?
  adAccountId String?
  source      String           @default("dry_run")
  status      ReportSyncStatus @default(RUNNING)
  rangeStart  DateTime         @db.Date
  rangeEnd    DateTime         @db.Date
  message     String?
  raw         Json?
  startedAt   DateTime         @default(now())
  finishedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  team        Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  adAccount   AdAccount? @relation(fields: [adAccountId], references: [id], onDelete: SetNull)

  @@index([teamId, status, createdAt])
  @@index([teamId, platform, rangeStart, rangeEnd])
}
