NODE_ENV=development

# API
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
SECRET_ENCRYPTION_KEY=replace-with-a-long-secret-for-database-encryption
OAUTH_STATE_SECRET=replace-with-a-long-secret-for-oauth-state-signing

# Platform developer apps, can also be managed in System -> Developer Keys
META_APP_ID=
META_APP_SECRET=
META_API_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=v25.0
META_REDIRECT_URI=http://localhost:4000/api/integrations/meta/callback
META_SCOPES=ads_management,ads_read,business_management,pages_read_engagement
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_AUTH_URL=https://business-api.tiktok.com/portal/auth
TIKTOK_API_BASE_URL=https://business-api.tiktok.com
TIKTOK_REDIRECT_URI=http://localhost:4000/api/integrations/tiktok/callback
TIKTOK_SCOPES=user.info.basic,biz.ad

# Publishing
PUBLISH_DRY_RUN=true

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/one_toufang?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Object storage
STORAGE_PROVIDER=r2
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api
